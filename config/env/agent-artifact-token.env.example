# ==========================================================
# AGENT ARTIFACT TOKEN — Shared Secret (TEMPLATE)
# ==========================================================
# Arquivo real NAO versionado. Copia segura em:
#   /etc/pi-chat/secrets/agent-artifact-token.env   (PRD)
#   ~/pi-chat-secrets/agent-artifact-token.env       (dev local)
#
# Permissoes: 600 (owner-only)
# Mesmo segredo logico compartilhado pelos consumidores:
#   - agent_bot
#   - agent_bot_chat_bridge
#   - mcp_server (apenas quando ENABLE_TEST_ARTIFACT_TOOL=true)
#
# NAO colocar no common.env
# NAO usar o nome legado AGENT_ARTIFACTS_TOKEN
# ==========================================================
AGENT_ARTIFACT_TOKEN=
