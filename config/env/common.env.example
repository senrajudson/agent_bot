# ==========================================================
# PI CHAT — Common Environment (TEMPLATE)
# ==========================================================
# Carregado antes do arquivo específico de cada serviço.
# Contém apenas variáveis compartilhadas por 2+ processos.

# ==========================================================
# PI WEB API
# ==========================================================
PI_WEB_API_BASE_URL=http://10.247.224.39/piwebapi
PI_SERVER_NAME=PIMS
PI_WEB_API_USERNAME=
PI_WEB_API_PASSWORD=
PI_WEB_API_VERIFY_SSL=false

# ==========================================================
# MATH TOOL
# ==========================================================
MATH_TOOL_BASE_URL=http://math_tool:8001
MATH_TOOL_TIMEOUT_SECONDS=120

# ==========================================================
# GRAFANA / LOKI
# ==========================================================
GRAFANA_LOKI_QUERY_RANGE_URL=
GRAFANA_BEARER_TOKEN=
PIMS_STATUS_LOKI_QUERY={job="zabbix_proxy"}
PIMS_STATUS_LOOKBACK_MINUTES=20
PIMS_STATUS_LIMIT=5000

# ==========================================================
# PHOENIX (endpoint apenas — project name é específico)
# ==========================================================
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
