# ==========================================================
# AGENT BOT - QA Local Environment Variables
# Copy this file to qa/.env.qa for local QA execution
# ==========================================================

# Ambientes e Identificação
APP_ENV=qa

# Redis QA exclusivo (Container local Docker em 127.0.0.1:6380, Database 0)
REDIS_URL=redis://127.0.0.1:6380/0
REDIS_KEY_PREFIX=pi_chat:qa:memory
CHAT_MEMORY_TTL_SECONDS=604800
CHAT_MEMORY_MAX_TURNS=8

# Configuração da API local
API_NAME=Bot Chat API QA
API_PORT=8002

# Math Tool local
MATH_TOOL_BASE_URL=http://localhost:8001

# MCP Server local
MCP_SERVER_URL=http://localhost:8005/mcp

# Artefatos da API e MCP Server (Raiz isolada /tmp/agent_bot_qa/)
AGENT_ARTIFACTS_BASE_DIR=/tmp/agent_bot_qa/api_artifacts
MCP_ARTIFACT_TEMP_DIR=/tmp/agent_bot_qa/mcp_artifacts
MCP_SERIES_CSV_PUBLISH_TEMP_DIR=/tmp/agent_bot_qa/mcp_series_csv

# Tracing e observabilidade
PHOENIX_PROJECT_NAME=pi-chat-api-qa
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=qa,app.channel=n8n

