# ==========================================================
# PI SYSTEM MCP SERVER - Environment Variables (TEMPLATE)
# ==========================================================
# Copie para .env e ajuste conforme seu ambiente.
#
# Docker (PRD): MATH_TOOL_BASE_URL=http://math_tool:8001
# QA local sem Docker: MATH_TOOL_BASE_URL=http://localhost:8001

# ==========================================================
# PI WEB API
# ==========================================================
PI_WEB_API_BASE_URL=http://10.247.224.39/piwebapi
PI_SERVER_NAME=PIMS
PI_WEB_API_USERNAME=
PI_WEB_API_PASSWORD=
PI_WEB_API_VERIFY_SSL=false

# ==========================================================
# GRAFANA / LOKI
# ==========================================================
GRAFANA_LOKI_QUERY_RANGE_URL=
GRAFANA_BEARER_TOKEN=
PIMS_STATUS_LOKI_QUERY={job="zabbix_proxy"}
PIMS_STATUS_LOOKBACK_MINUTES=20
PIMS_STATUS_LIMIT=5000

# ==========================================================
# MATH TOOL
# Use http://math_tool:8001 em Docker, http://localhost:8001 em QA local
# ==========================================================
MATH_TOOL_BASE_URL=http://math_tool:8001
MATH_TOOL_TIMEOUT_SECONDS=120

# ==========================================================
# MCP SERVER
# ==========================================================
MCP_HOST=0.0.0.0
MCP_PORT=8015

# ==========================================================
# AGENT BOT API — ARTIFACT UPLOAD
# ==========================================================
# URL base da API do Agent Bot (local: http://localhost:8002, Docker: http://agent_bot:8002)
AGENT_API_BASE_URL=http://localhost:8002

# Token compartilhado com a API (mesmo valor em app/.env)
AGENT_ARTIFACT_TOKEN=

# Timeout do upload em segundos
AGENT_ARTIFACT_UPLOAD_TIMEOUT_SECONDS=60

# Tamanho máximo de upload em bytes (default: 100 MB)
AGENT_ARTIFACT_MAX_UPLOAD_BYTES=104857600

# ==========================================================
# MCP DRIVE ARTIFACT DELIVERY
# ==========================================================
# Entrega automática de artefatos (CSV no Google Drive) para séries e tabelas.
# true  → tag_statistics(series) publica CSV e retorna apenas ArtifactManifest.
# false → tag_statistics(series) retorna ToolError (nunca inline).
# Requer GOOGLE_DRIVE_EXPORT_CREDENTIALS_FILE e GOOGLE_DRIVE_EXPORT_FOLDER_ID
# configurados. Precedência: environment(compose) > env_file > .env > defaults.
ENABLE_MCP_DRIVE_ARTIFACT_DELIVERY=false

# ==========================================================
# DRIVE CSV EXPORT (tool pública)
# ==========================================================
# Tool pública export_csv_to_drive_tool para exportação manual.
# Default: false — não registrada no FastMCP (recomendado para segurança).
# O DrivePublisher interno (artifact delivery) funciona independentemente.
ENABLE_DRIVE_CSV_EXPORT_TOOL=false

# ==========================================================
# FEATURE FLAG — TOOL DE REFERÊNCIA
# ==========================================================
# Habilita a tool de referência generate_test_artifact_tool (default: false).
# Manter false em produção — esta tool existe apenas para validar o
# fluxo de upload de artefatos MCP → API.
ENABLE_TEST_ARTIFACT_TOOL=false

# Caminho interno do container para o JSON de credencial da service account
# dedicada à exportação. Montado a partir de ./secrets/pi_chat_drive_exporter/
# no container mcp_server.
GOOGLE_DRIVE_EXPORT_CREDENTIALS_FILE=

# ID da pasta no Shared Drive onde os arquivos CSV serão criados.
GOOGLE_DRIVE_EXPORT_FOLDER_ID=

# Limites de validação
DRIVE_CSV_MAX_ROWS=500
DRIVE_CSV_MAX_COLUMNS=50
DRIVE_CSV_MAX_CELL_BYTES=32768
DRIVE_CSV_MAX_INPUT_BYTES=5242880
DRIVE_CSV_MAX_FILE_BYTES=10485760
DRIVE_CSV_UPLOAD_TIMEOUT_SECONDS=60
DRIVE_CSV_MAX_FILENAME_LENGTH=180
DRIVE_CSV_FORMULA_PROTECTION=true

