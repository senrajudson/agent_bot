# ==========================================================
# DOCKER COMPOSE - Environment Variables
# Copy this file to docker.env and fill in the values
# Used by docker-compose.yaml for container configuration
# ==========================================================

# ==========================================================
# PHOENIX (Docker Compose)
# ==========================================================
PHOENIX_ENABLED=true
PHOENIX_PROJECT_NAME=pi-chat-api
PHOENIX_COLLECTOR_ENDPOINT=http://phoenix:6006/v1/traces
PHOENIX_HOST=
PHOENIX_PORT=
PHOENIX_GRPC_PORT=
PHOENIX_WORKING_DIR=
PHOENIX_ALLOW_EXTERNAL_RESOURCES=

