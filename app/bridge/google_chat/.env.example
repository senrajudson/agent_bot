# ==========================================================
# Google Chat Bridge — Environment Variables (TEMPLATE)
# ==========================================================
# Copie para .env e ajuste conforme seu ambiente.
# Valores reais nunca devem ser versionados.

# ==========================================================
# GOOGLE CHAT
# ==========================================================
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CHAT_SUBSCRIPTION=
GOOGLE_CHAT_SCOPES=

# ==========================================================
# AGENT API
# ==========================================================
AGENT_INTERNAL_URL=http://localhost:8002/chat
AGENT_ARTIFACT_BASE_URL=http://localhost:8002/artifacts
AGENT_ARTIFACT_TOKEN=

# ==========================================================
# REDIS / DEDUPLICATION
# ==========================================================
# Padrão para Docker Compose: redis://redis:6379/0
# Para execução local fora do container: redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0
GOOGLE_CHAT_DEDUPE_TTL_SECONDS=86400

# ==========================================================
# THINKING MESSAGE
# ==========================================================
GOOGLE_CHAT_SEND_THINKING_MESSAGE=true
GOOGLE_CHAT_THINKING_TEXT=Um momento...

# ==========================================================
# CHAT ATTACHMENTS
# ==========================================================
ENABLE_CHAT_ATTACHMENTS=false
GOOGLE_CHAT_MAX_ATTACHMENTS_PER_MESSAGE=3
BRIDGE_ARTIFACT_TIMEOUT_SECONDS=30
BRIDGE_ARTIFACT_MAX_BYTES=26214400
BRIDGE_ARTIFACT_MAX_TOTAL_BYTES=52428800
