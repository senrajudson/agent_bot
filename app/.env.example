# ==========================================================
# AGENT BOT - Environment Variables
# Copy this file to .env and fill in the values
# ==========================================================

# ==========================================================
# API SERVER
# ==========================================================
API_NAME=

# ==========================================================
# LLM PROVIDER
# Options: groq, gemini, ollama, openai_compatible
# ==========================================================
LLM_PROVIDER=

# --- Groq ---
GROQ_API_KEY=
GROQ_MODEL=

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=

# --- OpenAI Compatible (OpenRouter, LM Studio, vLLM etc.) ---
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=

# --- Ollama (local) ---
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# ==========================================================
# PI WEB API
# ==========================================================
PI_WEB_API_BASE_URL=
PI_SERVER_NAME=
PI_WEB_API_USERNAME=
PI_WEB_API_PASSWORD=
PI_WEB_API_VERIFY_SSL=

# ==========================================================
# GRAFANA / LOKI
# ==========================================================
GRAFANA_LOKI_QUERY_RANGE_URL=
GRAFANA_BEARER_TOKEN=
PIMS_STATUS_LOKI_QUERY=
PIMS_STATUS_LOOKBACK_MINUTES=
PIMS_STATUS_LIMIT=

# ==========================================================
# MATH TOOL
# Local: http://localhost:8001 | Docker: http://math_tool:8001
# ==========================================================
MATH_TOOL_BASE_URL=http://localhost:8001
MATH_TOOL_TIMEOUT_SECONDS=

# ==========================================================
# MCP SERVER
# Local: http://localhost:8005/mcp | Docker: override via docker-compose
# ==========================================================
MCP_SERVER_URL=

# ==========================================================
# QDRANT / RAG
# ==========================================================
QDRANT_URL=
QDRANT_COLLECTION=
OLLAMA_EMBEDDING_MODEL=

# ==========================================================
# REDIS / MEMORY
# ==========================================================
REDIS_URL=
CHAT_MEMORY_TTL_SECONDS=
CHAT_MEMORY_MAX_TURNS=

# ==========================================================
# PHOENIX / OBSERVABILITY
# Local (QA): disabled | PRD: overridden in docker-compose
# ==========================================================
PHOENIX_ENABLED=false
PHOENIX_PROJECT_NAME=pi-chat-api-qa
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROTOCOL=http/protobuf

# ==========================================================
# EVENT STORE (optional PostgreSQL backend)
# Default: memory (InMemoryEventStore)
# ==========================================================
EVENT_STORE_BACKEND=memory
# EVENT_STORE_POSTGRES_DSN=postgresql://agent_bot:agent_bot@event_store_postgres:5432/agent_bot_events

# Preparation flag only; does not change /chat runtime in this cycle.
EVENT_DRIVEN_ENABLED=false

# ==========================================================
# GOOGLE CHAT BRIDGE
# ==========================================================
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CHAT_SUBSCRIPTION=
GOOGLE_CHAT_SCOPES=
AGENT_INTERNAL_URL=http://localhost:8002/chat
GOOGLE_CHAT_SEND_THINKING_MESSAGE=
GOOGLE_CHAT_THINKING_TEXT=
GOOGLE_CHAT_DEDUPE_TTL_SECONDS=
