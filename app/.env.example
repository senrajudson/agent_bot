# ==========================================================
# AGENT BOT - Environment Variables
# Copy this file to .env and fill in the values
# ==========================================================

# ==========================================================
# API DO BOT
# ==========================================================
API_NAME=
API_PORT=

# ==========================================================
# OLLAMA
# Bot fora do Docker: use http://localhost:11434
# Bot dentro do Docker: use http://ollama:11434
# ==========================================================
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# ==========================================================
# PI WEB API
# ==========================================================
PI_WEB_API_BASE_URL=
PI_SERVER_NAME=
PI_WEB_API_USERNAME=
PI_WEB_API_PASSWORD=
PI_WEB_API_VERIFY_SSL=

# ==========================================================
# GRAFANA / LOKI
# ==========================================================
GRAFANA_LOKI_QUERY_RANGE_URL=
GRAFANA_BEARER_TOKEN=
PIMS_STATUS_LOKI_QUERY=
PIMS_STATUS_LOOKBACK_MINUTES=
PIMS_STATUS_LIMIT=

# ==========================================================
# MATH TOOL
# Bot fora do Docker: use http://localhost:8001
# Bot dentro do Docker: use http://math_tool:8001
# ==========================================================
MATH_TOOL_BASE_URL=
MATH_TOOL_TIMEOUT_SECONDS=

# ==========================================================
# PHOENIX / OBSERVABILIDADE
# ==========================================================
PHOENIX_ENABLED=
PHOENIX_PROJECT_NAME=
PHOENIX_COLLECTOR_ENDPOINT=
PHOENIX_PROTOCOL=

# ==========================================================
# REDIS / MEMÓRIA
# ==========================================================
REDIS_URL=
CHAT_MEMORY_TTL_SECONDS=
CHAT_MEMORY_MAX_TURNS=

# ==========================================================
# LLM PROVIDER
# ==========================================================
LLM_PROVIDER=

# ==========================================================
# GEMINI
# ==========================================================
GEMINI_API_KEY=
GEMINI_MODEL=

# ==========================================================
# GROQ
# ==========================================================
GROQ_API_KEY=
GROQ_MODEL=

# ==========================================================
# OPENAI COMPATIBLE
# ==========================================================
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=

# ==========================================================
# GOOGLE PUB/SUB (worker mode)
# ==========================================================
# Set to true to start the Pub/Sub worker instead of the HTTP server
PUBSUB_ENABLED=false
# Your GCP project id
PUBSUB_PROJECT_ID=your-gcp-project
# Fully-qualified subscription path the worker will pull from
PUBSUB_INCOMING_SUBSCRIPTION=projects/your-gcp-project/subscriptions/agent-bot-incoming-sub
# Fully-qualified topic the worker will publish responses to
PUBSUB_OUTGOING_TOPIC=projects/your-gcp-project/topics/agent-bot-outgoing
# Max in-flight messages processed in parallel by the streaming pull
PUBSUB_WORKER_CONCURRENCY=4
# TTL for the request_id dedup keys in Redis
PUBSUB_DEDUP_TTL_SECONDS=3600
# Graceful shutdown wait for in-flight handlers
PUBSUB_SHUTDOWN_TIMEOUT_SECONDS=30

# Path to a service account JSON key with pubsub.subscriber + pubsub.publisher roles.
# In docker-compose this file is mounted into the worker container.
GOOGLE_APPLICATION_CREDENTIALS=
