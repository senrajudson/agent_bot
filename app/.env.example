# ==========================================================
# AGENT BOT - Environment Variables
# Copy this file to .env and fill in the values
# ==========================================================

# ==========================================================
# API SERVER
# ==========================================================
API_NAME=

# ==========================================================
# LLM PROVIDER
# Options: groq, gemini, ollama, openai_compatible
# ==========================================================
LLM_PROVIDER=

# --- Groq ---
GROQ_API_KEY=
GROQ_MODEL=

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=

# --- OpenAI Compatible (OpenRouter, LM Studio, vLLM etc.) ---
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=

# --- Ollama (local) ---
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# ==========================================================
# PI WEB API
# ==========================================================
PI_WEB_API_BASE_URL=
PI_SERVER_NAME=
PI_WEB_API_USERNAME=
PI_WEB_API_PASSWORD=
PI_WEB_API_VERIFY_SSL=

# ==========================================================
# GRAFANA / LOKI
# ==========================================================
GRAFANA_LOKI_QUERY_RANGE_URL=
GRAFANA_BEARER_TOKEN=
PIMS_STATUS_LOKI_QUERY=
PIMS_STATUS_LOOKBACK_MINUTES=
PIMS_STATUS_LIMIT=

# ==========================================================
# MATH TOOL
# Local: http://localhost:8001 | Docker: http://math_tool:8001
# ==========================================================
MATH_TOOL_BASE_URL=http://localhost:8001
MATH_TOOL_TIMEOUT_SECONDS=

# ==========================================================
# MCP SERVER
# Local: http://localhost:8005/mcp | Docker: override via docker-compose
# ==========================================================
MCP_SERVER_URL=

# ==========================================================
# RAG EMBEDDING PROVIDER
# Options: nomic (Ollama local, legado) | gemini (Google API)
# ==========================================================
EMBEDDING_PROVIDER=nomic
EMBEDDING_MODEL=
EMBEDDING_VECTOR_SIZE=768
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=60

# Gemini (usado quando EMBEDDING_PROVIDER=gemini)
# GEMINI_API_KEY=
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# ==========================================================
# QDRANT / RAG
# ==========================================================
QDRANT_URL=
QDRANT_COLLECTION=
OLLAMA_EMBEDDING_MODEL=

# ==========================================================
# REDIS / MEMORY
# ==========================================================
REDIS_URL=
CHAT_MEMORY_TTL_SECONDS=
CHAT_MEMORY_MAX_TURNS=

# ==========================================================
# PHOENIX / OBSERVABILITY
# Local (QA): disabled | PRD: overridden in docker-compose
# ==========================================================
PHOENIX_ENABLED=false
PHOENIX_PROJECT_NAME=pi-chat-api-qa
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROTOCOL=http/protobuf

# ==========================================================
# EVENT STORE (optional PostgreSQL backend)
# Default: memory (InMemoryEventStore)
# ==========================================================
EVENT_STORE_BACKEND=memory
# EVENT_STORE_POSTGRES_DSN=postgresql://agent_bot:agent_bot@event_store_postgres:5432/agent_bot_events

# When true AND EVENT_STORE_BACKEND=transactional_postgres, the app will
# attempt to create an asyncpg pool at startup (fail-fast on error). The
# pool is stored in app.state.postgres_pool. /chat runtime is NOT changed
# in this cycle — process_message continues to use InMemoryEventStore.
# Recommended: keep false in production until Prompt 9+ activates runtime.
EVENT_DRIVEN_ENABLED=false

# ==========================================================
# ARTIFACT LAYER
# ==========================================================
# Habilita o artifact storage/API (InMemoryArtifactStore single-worker).
# Default: false — endpoints /artifacts/* não são registrados.
ENABLE_ARTIFACTS=false

# Token compartilhado entre MCP server e a API de upload de artifacts.
# Obrigatório quando ENABLE_ARTIFACTS=true.
AGENT_ARTIFACT_TOKEN=

# TTL do artifact em segundos (default: 1 hora).
AGENT_ARTIFACT_TTL_SECONDS=3600

# Diretório base para armazenamento local de artifacts.
AGENT_ARTIFACTS_BASE_DIR=/tmp/agent_bot_artifacts

# Prefixo público dos endpoints de artifact (/artifacts/upload, /metadata, /download).
AGENT_ARTIFACTS_PUBLIC_PATH_PREFIX=/artifacts

# Limites de upload
AGENT_ARTIFACT_MAX_UPLOAD_BYTES=26214400      # 25 MB
AGENT_ARTIFACT_MAX_ATTACHMENTS=3
AGENT_ARTIFACT_MAX_TOTAL_BYTES=52428800        # 50 MB

# Allowlist de MIME types permitidos
AGENT_ARTIFACT_ALLOWED_MIME_TYPES=text/plain,text/csv,application/pdf,image/png,image/jpeg

# Extensões bloqueadas (segurança)
AGENT_ARTIFACT_BLOCKED_EXTENSIONS=.exe,.bat,.sh,.dll,.cmd,.com,.scr,.html,.htm,.svg,.zip,.tar,.gz,.7z,.rar

# ==========================================================
# CHAT ATTACHMENTS (BRIDGE)
# ==========================================================
# Habilita o envio de attachments (gráficos, CSVs, PDFs) para o Google Chat.
# Requer ENABLE_ARTIFACTS=true.
ENABLE_CHAT_ATTACHMENTS=false

# URL base da API de artifacts (app) - local: http://localhost:8002/artifacts
AGENT_ARTIFACT_BASE_URL=http://localhost:8002/artifacts
